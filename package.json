{
  "name": "around-g-poizon-desktop",
  "version": "2.10.122",
  "description": "Around G POIZON local sourcing workspace",
  "type": "module",
  "main": "bootstrap.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "dist": "npm run test && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "read-excel-file": "^9.3.4",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "kr.aroundg.poizon",
    "productName": "Around G POIZON",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "bootstrap.mjs",
      "main.mjs",
      "preload.cjs",
      "build/icon.png",
      "src/**/*",
      "services/**/*",
      "relay/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "7venik-bit",
      "repo": "around-g-poizon-desktop",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Around G POIZON"
    }
  }
}
